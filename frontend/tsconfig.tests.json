{
  "extends": "./tsconfig.app.json",
  "include": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "tests/**/*.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ],
  "exclude": [],
  "compilerOptions": {
    "composite": false,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tests.tsbuildinfo",
