{
  "name": "fullstack-scaffold-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vue 3 + Vite + TypeScript port of the fullstack scaffold frontend",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -p tsconfig.app.json --noEmit && vite build",
    "build:staging": "vue-tsc -p tsconfig.app.json --noEmit && vite build --mode staging",
    "build:report": "cross-env VITE_BUILD_REPORT=true vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "type-check": "vue-tsc -p tsconfig.app.json --noEmit",
    "lint": "eslint --ext .js,.ts,.vue src tests",
    "lint:fix": "eslint --ext .js,.ts,.vue src tests --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,scss,css,json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "gen:openapi": "node scripts/gen-openapi.mjs"
  },
  "engines": {
    "node": ">=18.18.0",
    "npm": ">=9"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@form-create/designer": "^3.4.0",
    "@form-create/element-ui": "^3.2.42",
    "@stomp/stompjs": "^7.3.0",
    "@wangeditor/editor": "^5.1.23",
    "@wangeditor/editor-for-vue": "^5.1.12",
    "axios": "^1.7.7",
    "bpmn-js": "^18.16.1",
    "echarts": "^5.5.1",
    "element-plus": "^2.8.6",
    "file-saver": "^2.0.5",
    "js-cookie": "^3.0.5",
    "nprogress": "^0.2.0",
    "pinia": "^2.2.4",
    "vue": "^3.5.12",
    "vue-echarts": "^7.0.3",
    "vue-i18n": "^9.14.4",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/file-saver": "^2.0.7",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^22.7.7",
    "@types/nprogress": "^0.2.3",
    "@typescript-eslint/eslint-plugin": "^8.10.0",
    "@typescript-eslint/parser": "^8.10.0",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vitest/ui": "^2.1.9",
    "@vue/eslint-config-typescript": "^13.0.0",
    "@vue/test-utils": "^2.4.10",
    "@vue/tsconfig": "^0.5.1",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.29.1",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.3.3",
    "rollup-plugin-visualizer": "^5.14.0",
    "sass": "^1.80.4",
    "typescript": "^5.6.3",
    "unplugin-auto-import": "^0.18.3",
    "unplugin-vue-components": "^0.27.4",
    "vite": "^5.4.10",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.1.10"
  }
}
