<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>scaffold</artifactId>
        <groupId>com.scaffold</groupId>
        <version>3.9.2</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>scaffold-module-report</artifactId>
    <description>
        报表模块（M-8）：自定义查询（SQL 模板 + 参数化 + 行数 / 超时配额 + select-only SqlGuard）
        + 数据看板（多卡片组合 + ECharts 渲染）。数据源支持主库 + 外部 JDBC（密码 AES 加密落库）。
        删除整个目录与 admin 中的依赖即下线，对其它模块零影响。
    </description>

    <dependencies>
        <!-- 框架核心：BaseController / @AuditLog / SecurityUtils / Aes256Util / ScaffoldModule -->
        <dependency>
            <groupId>com.scaffold</groupId>
            <artifactId>scaffold-framework</artifactId>
        </dependency>

        <!-- xlsx 导出（POI 已在 scaffold-common 用过，沿用统一版本） -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
        </dependency>

        <!-- Swagger / OpenAPI 注解 -->
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations-jakarta</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.junit.vintage</groupId>
                    <artifactId>junit-vintage-engine</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- H2 仅测试用：跑 ReportRunner 集成测试 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.2.224</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

</project>
